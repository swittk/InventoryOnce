      ],
      "rule": "Completed-cutover replay retains durable target evidence and compares source dispositions through their canonical migration fingerprint, making equivalent adapter key-order round trips replay-safe."
    },
    "storage": {
      "changedRuntime": [
        "fn:assertPublishedInventoryMigrationTarget",
        "method:InMemoryInventoryDurableStorage.completeMigrationManifestUnlocked"
      ],
      "rule": "R144 records and validates exact published migration target root/revision; other storage runtime declarations are unchanged."
    },
    "recordedDeficit": {
      "changedRuntime": [
        "fn:applyInventoryRecordedDeficitBurden",
        "fn:recordedDeficitByLocation"
      ],
      "rule": "R167 makes empty locationIds select every location for recorded-deficit burdening while preserving strict non-empty filtering and independent per-location deficit accounting."
    },
    "fungibility": {
      "changedRuntime": [
        "fn:fungibilityAllocationIncrement",
        "fn:positionHasIndependentMeasuredContents",
        "fn:positionHasUnfixedIndependentMeasuredContents"
      ],
      "rule": "Current review repair aligns fungibility allocation with ordinary picking: independent measurement axes fixed by intact packaging do not make the package unsplittable, while serial and genuinely unfixed measured contents retain whole-position allocation semantics."
    },
    "reservationConsumption": {
      "changedRuntime": [
        "fn:assertReservationConsumptionMatchesIssue",
        "fn:reservationLifecycleEvidenceFingerprint"
      ],
      "rule": "Consume validation compares the full normalized reservation lifecycle through a canonical field-complete fingerprint, so equivalent independently materialized object-key order is accepted while allocation order and every semantic field remain exact."
    },
    "integrityTransitions": {
      "changedRuntime": [
        "fn:assertAllowedCountTransition",
        "fn:normalizedJsonObjectKeys",
        "fn:sameJson",
        "fn:sameNormalizedJsonValue"
      ],
      "rule": "Integrity comparisons are recursively order-insensitive for object keys but preserve arrays exactly, and reconciliation event identity is admitted only by count completion."
    },
    "migrationReplay": {
      "changedRuntime": [
        "fn:createDurableInventoryMigrationPlan",
        "fn:dryRunInventoryMigration"
      ],
      "rule": "Migration planning reuses one immutable catalog snapshot per run; the snapshot value is unchanged and existing migration replay/plan assertions remain green."
    }
