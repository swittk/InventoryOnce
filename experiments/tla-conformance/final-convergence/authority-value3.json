        "completeSource": "export function requireInventoryAuthorityMode<TMode extends string>(actual: TMode, required: TMode, operation = \"Inventory operation\"): void {\n    if (actual !== required) {\n        throw new Error(`${operation} requires authority mode '${required}', current mode is '${actual}'.`);\n    }\n}"
      },
