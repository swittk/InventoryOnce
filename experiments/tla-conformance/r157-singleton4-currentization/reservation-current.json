  "equations": [
    {
      "id": "src/reservations.ts#assertInventoryReservationsFeasible",
      "equationSha256": "fd8206801be39d7bcdd11627ebd1f8d5ca91b6859ac7b11070c16d65bbade130",
      "canonicalSource": "export function assertInventoryReservationsFeasible({ catalog, projection, book, at, }: AssertInventoryReservationsFeasibleInput): void {\n    const report = inspectInventoryReservationFeasibility({\n        catalog,\n        projection,\n        book,\n        at,\n    });\n    if (report.status === InventoryReservationFeasibilityStatus.Feasible)\n        return;\n    const shortReservationIds: string[] = [];\n    for (const group of report.groups) {\n        if (group.shortage.amountMinor === 0)\n            continue;\n        shortReservationIds.push(...group.reservationIds);\n    }\n    shortReservationIds.sort();\n    throw new Error(`Inventory reservations cannot all be fulfilled simultaneously: ${shortReservationIds.join(\", \")}.`);\n}"
    }
  ],
